<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================================
         V1 BASELINE (SCRUM-107, owner directive 2026-08-08). THIS FILE MINTS
         man_initial_response FOR THE FIRST AND ONLY TIME.

         Every DCRE database is dropped and recreated for the direct cut-over, so there is no
         historic state, no deployed schema and nothing to converge. The one object this file
         creates has EXACTLY ONE creator: MIR. Neither the infra bootstrap
         (dcre-infra scripts/seed-man-core.sql, which creates only the three shared reference
         tables) nor any of the other nine M-services writes man_initial_response, so on a
         brand-new dcre_man it cannot already exist and there is nothing for a MARK_RAN guard
         to converge with.

         The retrofit apparatus is therefore ABSENT BY DESIGN and must not be re-added:

           - no onFail="MARK_RAN" tableExists precondition: a single-creator object cannot
             lose a race that has no second runner, and a guard here would silently MARK_RAN
             a genuine failure to create the table;
           - no validCheckSum: no checksum was ever recorded anywhere;
           - no defensive IF NOT EXISTS on the CREATE: nothing exists;
           - no additive addColumn or index swap: the shape below IS the shape, folded into
             the one createTable.

         The <rollback> stays. Dropping the table when this changeset is rolled BACK is a
         rollback, not a retrofit, and v1 keeps it.
         =================================================================================== -->

    <!-- man_initial_response is MIR's first domain table and the write-ahead
         filename ledger / system of record for every initial mandate ACK/NACK,
         cloned from cir_response (collections initial response). One row per
         arrival, committed BEFORE the response file is staged to onhost-resp-man/out.
         route_id IS part of identity (A-45 cross-route twin lesson): the same
         (client, msgId) on distinct man routes are distinct arrivals with distinct
         files. reason persists the NACK reason (validation FAIL or MAS SCORE_DECLINED);
         accepted_count/total_count give the per-file acceptance ratio. written_at
         NULL after commit = staged-not-written stuck signal. MIR does NOT transition
         the spine forward (it is the terminal response leg, DAG MIT -> {MIR, MRW});
         this ledger is MIR's ONLY write, guarded idempotent on arrival_id. -->
    <changeSet id="mir-001-man-initial-response" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:606eaebcd9496e2781d354077ab5a7eb,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="man_initial_response"/></not>
        </preConditions>
        
        <createTable tableName="man_initial_response">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_man_init_resp_arrival"/>
            </column>
            <column name="client" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="msg_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="route_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(4)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_man_init_resp_file"/>
            </column>
            <column name="reason" type="VARCHAR(64)"/>
            <column name="accepted_count" type="INT"/>
            <column name="total_count" type="INT"/>
            <column name="written_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="man_initial_response"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
