<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================================
         V1 BASELINE (SCRUM-107, owner directive 2026-08-08). Spring Batch 6.0.4 metadata for
         MIR, table-prefixed MIR_BATCH_ so this service is the single writer of its own job
         repository (R-34). EXIT_MESSAGE is widened to TEXT so a CockroachDB driver cause
         chain is never truncated.

         PURE XML, TYPED TAGS, ONE CHANGESET PER OBJECT. This replaces the sqlFile that used
         to carry the autogenerated Spring Batch DDL, and the replacement is what removes all
         three pieces of retrofit scar tissue at once rather than working around them:

           - <validCheckSum>ANY</validCheckSum> is GONE. It existed because editing the .sql
             changed the single changeset's checksum on databases that had already run it.
             There are no such databases in v1, and there is no longer a single changeset.
           - IF NOT EXISTS on every CREATE is GONE. It existed because one changeset covering
             nine objects is all-or-nothing: a pod SIGKILLed mid-file left the tables present,
             the sequences absent and no history row, so the re-run either collided with an
             existing table or skipped the whole file and left the schema permanently broken.
             Nine changesets fix that properly. Each object commits its own history row, so a
             kill resumes at the exact object it died on, which is what the defensive clause
             was approximating.
           - The raw .sql file is GONE, so the changelog is portable typed XML throughout
             (rules/be/java/persistence.md, pure-XML mandate).

         No changeset here carries a MARK_RAN guard: every object is MIR_BATCH_-prefixed and
         MIR is the only service that creates it, so on a v1 database it cannot already exist.

         Constraint names (JOB_INST_UN, JOB_INST_EXEC_FK, ...) are Spring Batch's own and are
         deliberately NOT service-prefixed, matching the DDL this replaces. CockroachDB scopes
         index and constraint names to the table, so the ten services' copies coexist in the
         one dcre_man exactly as they did before.
         =================================================================================== -->

    <changeSet id="mir-002-batch-job-instance" author="dcre">
        <createTable tableName="MIR_BATCH_JOB_INSTANCE">
            <column name="JOB_INSTANCE_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"/>
            <column name="JOB_NAME" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="JOB_KEY" type="VARCHAR(32)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="MIR_BATCH_JOB_INSTANCE" columnNames="JOB_NAME, JOB_KEY"
                             constraintName="JOB_INST_UN"/>
    </changeSet>

    <changeSet id="mir-002-batch-job-execution" author="dcre">
        <createTable tableName="MIR_BATCH_JOB_EXECUTION">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"/>
            <column name="JOB_INSTANCE_ID" type="BIGINT"><constraints nullable="false"/></column>
            <column name="CREATE_TIME" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="START_TIME" type="TIMESTAMP"/>
            <column name="END_TIME" type="TIMESTAMP"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="EXIT_CODE" type="VARCHAR(2500)"/>
            <!-- TEXT, not VARCHAR(2500): a truncated CockroachDB cause chain is unreadable. -->
            <column name="EXIT_MESSAGE" type="TEXT"/>
            <column name="LAST_UPDATED" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_INST_EXEC_FK"
                                 baseTableName="MIR_BATCH_JOB_EXECUTION" baseColumnNames="JOB_INSTANCE_ID"
                                 referencedTableName="MIR_BATCH_JOB_INSTANCE" referencedColumnNames="JOB_INSTANCE_ID"/>
    </changeSet>

    <changeSet id="mir-002-batch-job-execution-params" author="dcre">
        <createTable tableName="MIR_BATCH_JOB_EXECUTION_PARAMS">
            <column name="JOB_EXECUTION_ID" type="BIGINT"><constraints nullable="false"/></column>
            <column name="PARAMETER_NAME" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="PARAMETER_TYPE" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="PARAMETER_VALUE" type="VARCHAR(2500)"/>
            <column name="IDENTIFYING" type="CHAR(1)"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_PARAMS_FK"
                                 baseTableName="MIR_BATCH_JOB_EXECUTION_PARAMS" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="MIR_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
    </changeSet>

    <changeSet id="mir-002-batch-step-execution" author="dcre">
        <createTable tableName="MIR_BATCH_STEP_EXECUTION">
            <column name="STEP_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"><constraints nullable="false"/></column>
            <column name="STEP_NAME" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="JOB_EXECUTION_ID" type="BIGINT"><constraints nullable="false"/></column>
            <column name="CREATE_TIME" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="START_TIME" type="TIMESTAMP"/>
            <column name="END_TIME" type="TIMESTAMP"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="COMMIT_COUNT" type="BIGINT"/>
            <column name="READ_COUNT" type="BIGINT"/>
            <column name="FILTER_COUNT" type="BIGINT"/>
            <column name="WRITE_COUNT" type="BIGINT"/>
            <column name="READ_SKIP_COUNT" type="BIGINT"/>
            <column name="WRITE_SKIP_COUNT" type="BIGINT"/>
            <column name="PROCESS_SKIP_COUNT" type="BIGINT"/>
            <column name="ROLLBACK_COUNT" type="BIGINT"/>
            <column name="EXIT_CODE" type="VARCHAR(2500)"/>
            <!-- TEXT, not VARCHAR(2500): see MIR_BATCH_JOB_EXECUTION.EXIT_MESSAGE. -->
            <column name="EXIT_MESSAGE" type="TEXT"/>
            <column name="LAST_UPDATED" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_STEP_FK"
                                 baseTableName="MIR_BATCH_STEP_EXECUTION" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="MIR_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
    </changeSet>

    <changeSet id="mir-002-batch-step-execution-context" author="dcre">
        <createTable tableName="MIR_BATCH_STEP_EXECUTION_CONTEXT">
            <column name="STEP_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)"><constraints nullable="false"/></column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint constraintName="STEP_EXEC_CTX_FK"
                                 baseTableName="MIR_BATCH_STEP_EXECUTION_CONTEXT" baseColumnNames="STEP_EXECUTION_ID"
                                 referencedTableName="MIR_BATCH_STEP_EXECUTION" referencedColumnNames="STEP_EXECUTION_ID"/>
    </changeSet>

    <changeSet id="mir-002-batch-job-execution-context" author="dcre">
        <createTable tableName="MIR_BATCH_JOB_EXECUTION_CONTEXT">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)"><constraints nullable="false"/></column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_CTX_FK"
                                 baseTableName="MIR_BATCH_JOB_EXECUTION_CONTEXT" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="MIR_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
    </changeSet>

    <!-- The three sequences Spring Batch's incrementers read. They were created LAST in the
         file this replaces, which is precisely why a mid-file kill used to leave a schema
         with every table and no sequence. -->
    <changeSet id="mir-002-batch-step-execution-seq" author="dcre">
        <createSequence sequenceName="MIR_BATCH_STEP_EXECUTION_SEQ" maxValue="9223372036854775807" cycle="false"/>
    </changeSet>

    <changeSet id="mir-002-batch-job-execution-seq" author="dcre">
        <createSequence sequenceName="MIR_BATCH_JOB_EXECUTION_SEQ" maxValue="9223372036854775807" cycle="false"/>
    </changeSet>

    <changeSet id="mir-002-batch-job-instance-seq" author="dcre">
        <createSequence sequenceName="MIR_BATCH_JOB_INSTANCE_SEQ" maxValue="9223372036854775807" cycle="false"/>
    </changeSet>

</databaseChangeLog>
