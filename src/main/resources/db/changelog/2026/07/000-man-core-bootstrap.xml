<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================================
         V1 BASELINE (SCRUM-107, owner directive 2026-08-08). THIS IS THE FIRST MIGRATION ANY
         dcre_man WILL EVER SEE.

         Every DCRE database is dropped and recreated for the direct cut-over, so there is no
         historic state, no deployed schema and nothing to converge. The retrofit apparatus a
         migration needs is therefore ABSENT BY DESIGN and must not be re-added:

           - no <validCheckSum>ANY</validCheckSum>: no checksum was ever recorded anywhere;
           - no defensive IF NOT EXISTS on a CREATE: nothing exists;
           - no create-then-drop pair retiring a shape v1 simply never mints. The `mandate`
             PROJECTION is the one that used to live here. It had no writer after MSR was
             deleted and no reader in any service, so v1 does not create it at all, and the
             guarded drop that used to retire it is gone with it.

         THE MARK_RAN GUARDS THAT REMAIN ARE CONVERGENCE GUARDS, NOT RETROFITS, and each says
         which writer it converges with. Two independent writers can put these three shared
         reference tables in place before this changelog runs on a brand-new database:

           1. the infra bootstrap, dcre-infra scripts/seed-man-core.sql, which creates and
              seeds account_type, account and mandate_reason_code in dcre_man; and
           2. any of the other nine M-services, because all ten migrate the one dcre_man with
              ten independent history + lock tables and NOTHING serializes them.

         So on an empty database these objects genuinely can already exist, which is exactly
         the condition a MARK_RAN guard is for. The rest of this file's changesets create
         objects only this service creates and carry no guard.

         SHARED-CORE CANON: this file is byte-identical across ALL TEN M-services, MRG
         included; only the mir-prefixed changeset ids differ. Reviewers diff the copies, so
         an edit to one copy is an edit to all ten.

         FK relationships are deliberately SHAPE-ONLY (columns + indexes, no DB constraints)
         so the convergent pre-creates above can land in any service order.
         =================================================================================== -->

    <changeSet id="mir-000-account-type" author="dcre">
        <!-- CONVERGENCE GUARD: infra seed-man-core.sql or a sibling M-service may have
             created this table already. See the file header. -->
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="account_type"/></not>
        </preConditions>
        <createTable tableName="account_type">
            <column name="code" type="VARCHAR(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="mandates_allowed" type="BOOLEAN"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="mir-000-account-type-seed" author="dcre">
        <!-- A-62 (FNB account-type roster attestation pending): CHQ/SAV/TRN/CC/RF
             per the spec roster. AG01 semantics: mandates are disallowed on
             Savings only; every other type allows them until attested otherwise. -->
        <!-- CONVERGENCE GUARD: infra seed-man-core.sql seeds these same rows, so the seed is
             skipped when the reference core is already populated. -->
        <!-- LIQUIBASE-SQL-EXCEPTION: seed emptiness has no typed precondition;
             rowCount can only be probed via sqlCheck. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM account_type</sqlCheck>
        </preConditions>
        <insert tableName="account_type">
            <column name="code" value="CHQ"/>
            <column name="description" value="Cheque/Current"/>
            <column name="mandates_allowed" valueBoolean="true"/>
        </insert>
        <insert tableName="account_type">
            <column name="code" value="SAV"/>
            <column name="description" value="Savings"/>
            <column name="mandates_allowed" valueBoolean="false"/>
        </insert>
        <insert tableName="account_type">
            <column name="code" value="TRN"/>
            <column name="description" value="Transmission"/>
            <column name="mandates_allowed" valueBoolean="true"/>
        </insert>
        <insert tableName="account_type">
            <column name="code" value="CC"/>
            <column name="description" value="Credit Card"/>
            <column name="mandates_allowed" valueBoolean="true"/>
        </insert>
        <insert tableName="account_type">
            <column name="code" value="RF"/>
            <column name="description" value="Revolving Facility/ENDO"/>
            <column name="mandates_allowed" valueBoolean="true"/>
        </insert>
        <!-- m3: rollback deletes ONLY the codes this changeset seeds, never the
             whole table (the shared core may hold attested rows this owns none of). -->
        <rollback>
            <delete tableName="account_type">
                <where>code IN ('CHQ', 'SAV', 'TRN', 'CC', 'RF')</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="mir-000-account" author="dcre">
        <!-- CONVERGENCE GUARD: see the file header.

             [!CONVENTION-OVERRIDE] `account.account_number` repeats its own host table and by
             rules/be/java/architecture.md ("Column & field naming") should be `account.number`.
             It is NOT autocorrected here. The column's canonical shape is minted by
             dcre-infra scripts/seed-man-core.sql, which this changeset MARK_RANs behind, and
             an identically-named column is carried by the collections family's own copy of
             the account master. Renaming it in the mandates changelogs alone would leave the
             infra seed as the winning writer on every real environment while every mandates
             test, which builds the table from THIS file, went green against the new name: a
             rename that passes its suite and breaks the cluster. The coordinated edit set
             spanning dcre-infra, collections and mandates is written up in the SCRUM-107
             report; the rename lands there, in one wave, or not at all. -->
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="account"/></not>
        </preConditions>
        <createTable tableName="account">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_account_number"/>
            </column>
            <!-- FK-shaped to account_type.code; constraint deliberately app-side. Names its
                 TARGET table, so the no-host-prefix rule exempts it. -->
            <column name="account_type_code" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="product_code" type="VARCHAR(8)"/>
            <column name="status" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="account" indexName="ix_account_type_code">
            <column name="account_type_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="mir-000-mandate-reason-code" author="dcre">
        <!-- CONVERGENCE GUARD: see the file header. -->
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="mandate_reason_code"/></not>
        </preConditions>
        <createTable tableName="mandate_reason_code">
            <column name="code" type="VARCHAR(4)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="system_action" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="accepted" type="BOOLEAN"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="mir-000-mandate-reason-code-seed" author="dcre">
        <!-- R-21: reason codes + system actions live as reference DATA, never
             enum ordinals. Vocabulary per the ISO 20022 external status-reason
             set as pinned in plan T3; accepted=false throughout (the nine are
             reject/terminal reasons; accepted-with-reason codes arrive when
             attested). -->
        <!-- CONVERGENCE GUARD: infra seed-man-core.sql seeds these same rows. -->
        <!-- LIQUIBASE-SQL-EXCEPTION: seed emptiness has no typed precondition;
             rowCount can only be probed via sqlCheck. -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM mandate_reason_code</sqlCheck>
        </preConditions>
        <insert tableName="mandate_reason_code">
            <column name="code" value="AC01"/>
            <column name="description" value="Incorrect account number"/>
            <column name="system_action" value="NO_RETRY"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="AC04"/>
            <column name="description" value="Closed account number"/>
            <column name="system_action" value="PERMANENT_FAIL"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="AC06"/>
            <column name="description" value="Blocked account"/>
            <column name="system_action" value="BLOCKED"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="AG01"/>
            <column name="description" value="Transaction forbidden on account type"/>
            <column name="system_action" value="DISALLOWED_TYPE"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="MD01"/>
            <column name="description" value="No mandate / unknown mandate"/>
            <column name="system_action" value="UNKNOWN_MANDATE"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="MD06"/>
            <column name="description" value="Refund request by end customer"/>
            <column name="system_action" value="DISPUTE"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="MD07"/>
            <column name="description" value="End customer deceased"/>
            <column name="system_action" value="TERMINATE_NOW"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <insert tableName="mandate_reason_code">
            <column name="code" value="MS03"/>
            <column name="description" value="Reason not specified"/>
            <column name="system_action" value="BANK_RISK"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <!-- m2 marker: ISO 20022 external status-reason TM01 is CutOffTime; DCRE
             REPURPOSES it here as the authorisation-window-expiry reason per plan
             (PDNG starts the timer; system_action EXPIRE stays). The seeded
             description/system_action are shape-canon with infra seed-man-core.sql. -->
        <insert tableName="mandate_reason_code">
            <column name="code" value="TM01"/>
            <column name="description" value="Authorisation window timeout"/>
            <column name="system_action" value="EXPIRE"/>
            <column name="accepted" valueBoolean="false"/>
        </insert>
        <!-- m3: rollback deletes ONLY the nine reason codes this changeset seeds. -->
        <rollback>
            <delete tableName="mandate_reason_code">
                <where>code IN ('AC01', 'AC04', 'AC06', 'AG01', 'MD01', 'MD06', 'MD07', 'MS03', 'TM01')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
